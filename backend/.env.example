# Copy this file to backend/.env and fill in your real values.
# backend/.env is NEVER committed to git (see .gitignore) - it holds
# real secrets and is specific to your machine.

# Which LLM provider to use for MOM generation (Phase 6).
# "groq"   - free, no credit card ever required. RECOMMENDED DEFAULT.
# "gemini" - Google's Gemini API. Requires billing linked to avoid
#            free-tier quota errors (see Documentation.txt Phase 6
#            addendum for details).
LLM_PROVIDER=groq

# Required if LLM_PROVIDER=groq (the default).
# Get a free key (no credit card, ever) at:
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional - override the default Groq model.
# GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Required only if LLM_PROVIDER=gemini.
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional - override the default Gemini model.
# GEMINI_MODEL_NAME=gemini-2.0-flash

# --------------------------------------------------------------------
# Authentication (Phase 12) - JWT signing secret + token lifetime.
# --------------------------------------------------------------------
# SECRET_KEY signs the JWT access tokens. Set it to a long, random value
# for any real deployment. If it is unset, a random per-process secret is
# generated (local dev works out of the box, but you'll need to log in
# again after a server restart and tokens won't survive across processes).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=generate-some-64-byte-random-string-here
SECRET_KEY=your_long_random_secret_key_here

# Access token lifetime in minutes. After this expires the frontend must
# re-authenticate (log in again). 60 = 1 hour.
# ACCESS_TOKEN_EXPIRE_MINUTES=60

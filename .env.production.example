# ==============================================================================
# AI Meeting MOM Generator — Production Environment Variables (.env)
# Copy this file to .env before deploying: `cp .env.production.example .env`
# ==============================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=mom_user
POSTGRES_PASSWORD=replace_with_a_secure_database_password
POSTGRES_DB=mom_db

# Security & Authentication
SECRET_KEY=replace_with_a_random_64_character_hex_secret_for_jwt_signing
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=15
ENV=production

# LLM Providers (at least one key required)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_production_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Alternative Gemini Provider (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Speech-to-Text (Faster-Whisper on CPU)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Speaker Diarization (Optional)
DIARIZATION_ENABLED=false
DIARIZATION_MAX_SPEAKERS=6
DIARIZATION_DISTANCE_THRESHOLD=15.0

# Rate Limiting
RATE_LIMIT_ENABLED=true
